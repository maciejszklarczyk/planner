# define your env variables for the test env here
APP_ENV=test
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999

# Use SQLite for tests (in-memory or file-based)
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"

# Redis is NOT used in tests (uses filesystem/array storage instead)
# See config/packages/test/cache.yaml and config/packages/test/lock.yaml

FRONTEND_URL=http://localhost:3000
MAILER_FROM=noreply@example.com
MAILER_DSN=null://null
FRIEND_REQUEST_COOLDOWN_DAYS=3
