POSTGRES_DB="planner"
POSTGRES_PASSWORD="password"
POSTGRES_USER="planner_user"

###> symfony/mailer ###
MAILER_DSN=smtp://planner-mailpit:1025
###< symfony/mailer ###

###> redis ###
REDIS_HOST=${PROJECT_NAME}-redis
REDIS_PORT=6379
###< redis ###

